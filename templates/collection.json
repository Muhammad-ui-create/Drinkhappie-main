      "settings": {
        "title": "",
        "custom_liquid": "<style>\n  .happie-coll-seo{font-family:'Poppins',system-ui,-apple-system,sans-serif;max-width:1100px;margin:0 auto;padding:48px 24px 104px;color:#2a2a2a;position:relative;\n    background:radial-gradient(120% 90% at 8% 0%,rgba(80,178,189,.16),transparent 46%),radial-gradient(120% 90% at 92% 8%,rgba(255,159,49,.16),transparent 46%),radial-gradient(130% 100% at 82% 100%,rgba(150,47,128,.14),transparent 52%),radial-gradient(120% 100% at 12% 100%,rgba(247,205,70,.14),transparent 48%),#ffffff;\n    border-radius:32px;}\n  .happie-coll-seo__intro{max-width:780px;margin:0 auto 8px;text-align:center;}\n  .happie-coll-seo__eyebrow{display:inline-block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:800;color:#fff;background:linear-gradient(90deg,#50B2BD,#962F80);padding:8px 18px;border-radius:999px;margin-bottom:16px;box-shadow:0 6px 18px rgba(150,47,128,.22);}\n  .happie-coll-seo h2{font-size:clamp(28px,4vw,42px);font-weight:800;color:#962F80;margin:0 0 14px;line-height:1.12;}\n  .happie-coll-seo__lead{font-size:17px;line-height:1.75;color:#4a4a4a;margin:0 0 8px;}\n  .happie-coll-seo__features{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px;margin:34px 0;}\n  .happie-coll-seo__feature{background:#fff;border-radius:20px;padding:26px 22px 24px;text-align:left;box-shadow:0 10px 30px rgba(150,47,128,.09);border:1px solid rgba(150,47,128,.08);transition:transform .2s ease,box-shadow .2s ease;position:relative;overflow:hidden;}\n  .happie-coll-seo__feature::before{content:\"\";position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,#50B2BD,#962F80);}\n  .happie-coll-seo__feature:hover{transform:translateY(-5px);box-shadow:0 18px 38px rgba(150,47,128,.16);}\n  .happie-coll-seo__feature-icon{width:50px;height:50px;border-radius:15px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#962F80,#50B2BD);margin-bottom:14px;font-size:25px;line-height:1;box-shadow:0 8px 18px rgba(150,47,128,.20);}\n  .happie-coll-seo__feature:nth-child(1) .happie-coll-seo__feature-icon{background:linear-gradient(135deg,#50B2BD,#3a8f99);}\n  .happie-coll-seo__feature:nth-child(2) .happie-coll-seo__feature-icon{background:linear-gradient(135deg,#ff9f31,#ff7a45);}\n  .happie-coll-seo__feature:nth-child(3) .happie-coll-seo__feature-icon{background:linear-gradient(135deg,#962F80,#6c36a8);}\n  .happie-coll-seo__feature:nth-child(4) .happie-coll-seo__feature-icon{background:linear-gradient(135deg,#F7CD46,#ff9f31);}\n  .happie-coll-seo__feature h4{font-size:16px;font-weight:800;color:#1a1a1a;margin:0 0 7px;}\n  .happie-coll-seo__feature p{font-size:14px;line-height:1.55;color:#666;margin:0;}\n  .happie-coll-seo__why{background:linear-gradient(135deg,rgba(80,178,189,.12),rgba(150,47,128,.12));border:1px solid rgba(150,47,128,.14);border-radius:26px;padding:40px clamp(22px,4vw,52px);margin-top:8px;box-shadow:0 14px 40px rgba(150,47,128,.10);}\n  .happie-coll-seo__why h3{font-size:clamp(22px,3vw,30px);font-weight:800;color:#962F80;text-align:center;margin:0 0 18px;}\n  .happie-coll-seo__why p{font-size:15.5px;line-height:1.8;color:#4a4a4a;margin:0 auto 14px;max-width:800px;text-align:center;}\n  .happie-coll-seo__badges{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:26px;}\n  .happie-coll-seo__badge{font-size:13px;font-weight:700;color:#962F80;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(90deg,#50B2BD,#962F80) border-box;border:1.5px solid transparent;padding:9px 17px;border-radius:999px;}\n  @media(max-width:600px){.happie-coll-seo{padding:36px 16px 92px;border-radius:24px;}.happie-coll-seo__why{padding:30px 22px;}.happie-coll-seo__feature{padding:22px 18px;}}\n</style>\n<div class=\"happie-coll-seo\">\n  {% if collection.handle == 'thc-drinks' or collection.handle == 'thc' or collection.handle == 'frontpage' %}\n  <div class=\"happie-coll-seo__intro\">\n    <span class=\"happie-coll-seo__eyebrow\">Hemp-Derived Delta-9 THC</span>\n    <h2>{{ collection.title }}</h2>\n    <p class=\"happie-coll-seo__lead\">Happie THC seltzers are premium hemp-derived Delta-9 THC beverages crafted in California. Each can contains nano-emulsified THC for fast-acting effects in 15&ndash;30 minutes &mdash; no waiting hours like traditional edibles.</p>\n  </div>\n  <div class=\"happie-coll-seo__features\">\n    <div class=\"happie-coll-seo__feature\"><div class=\"happie-coll-seo__feature-icon\">⚡</div><h4>Fast-Acting</h4><p>Nano-emulsified THC kicks in within 15&ndash;30 minutes &mdash; not hours.</p></div>\n    <div class=\"happie-coll-seo__feature\"><div class=\"happie-coll-seo__feature-icon\">⚖️</div><h4>Balanced 1:1</h4><p>A perfect 1:1 THC-to-CBD ratio for a smooth, controlled, functional buzz.</p></div>\n    <div class=\"happie-coll-seo__feature\"><div class=\"happie-coll-seo__feature-icon\">🌊</div><h4>Ocean Minerals</h4><p>Ocean-sourced trace minerals in every can.</p></div>\n    <div class=\"happie-coll-seo__feature\"><div class=\"happie-coll-seo__feature-icon\">🍃</div><h4>Just 30 Calories</h4><p>Sweetened with organic agave. Vegan, gluten-free, non-GMO, zero artificial flavors.</p></div>\n  </div>\n  <div class=\"happie-coll-seo__why\">\n    <h3>Why Happie Is the Best THC Seltzer</h3>\n    <p>Looking for the best THC seltzer? Happie leads the category with nano-emulsified absorption, organic agave sweetener, ocean minerals, and a perfect 1:1 THC-to-CBD ratio. Whether you want a cannabis seltzer for social gatherings, a weed drink for relaxation, or a healthy alcohol alternative for mindful drinking &mdash; Happie is the premium choice for hemp-infused beverages.</p>\n    <p>Available in 5mg and 10mg strengths across 7 fruit flavors &mdash; Mango Mimosa, Grateful Grape, Watermelon, Blue Razzberry, Groovy Grapefruit, Cheery Cherry, and Sublime. Perfect for the sober curious movement, party drink alternatives, and anyone seeking a low-calorie cannabis beverage.</p>\n    <div class=\"happie-coll-seo__badges\">\n      <span class=\"happie-coll-seo__badge\">3rd-Party Lab Tested</span>\n      <span class=\"happie-coll-seo__badge\">2018 Farm Bill Compliant</span>\n      <span class=\"happie-coll-seo__badge\">Ships to 40+ States</span>\n      <span class=\"happie-coll-seo__badge\">7 Fruit Flavors</span>\n      <span class=\"happie-coll-seo__badge\">Subscribe &amp; Save 20%</span>\n    </div>\n  </div>\n  {% elsif collection.handle == 'fungi-fusion' or collection.handle == 'fungi' %}\n  <div class=\"happie-coll-seo__intro\">\n    <span class=\"happie-coll-seo__eyebrow\">Functional Mushroom Drinks</span>\n    <h2>{{ collection.title }}</h2>\n    <p class=\"happie-coll-seo__lead\">Fungi Fusion is Happie&rsquo;s line of sparkling mushroom drinks &mdash; made with Lion&rsquo;s Mane, Cordyceps and Red Reishi plus magnesium and calcium from ocean minerals, sweetened with organic agave. Caffeine-free, alcohol-free, 40 calories, 9g sugar, no artificial sweeteners.</p>\n  </div>\n  <div class=\"happie-coll-seo__features\">\n    <div class=\"happie-coll-seo__feature\"><div class=\"happie-coll-seo__feature-icon\">🍄</div><h4>Three Mushrooms</h4><p>Lion&rsquo;s Mane, Cordyceps and Red Reishi &mdash; dual-extracted from the fruiting body.</p></div>\n    <div class=\"happie-coll-seo__feature\"><div class=\"happie-coll-seo__feature-icon\">🌊</div><h4>Ocean Minerals</h4><p>Magnesium and calcium from Aquamin&reg; red algae in every can.</p></div>\n    <div class=\"happie-coll-seo__feature\"><div class=\"happie-coll-seo__feature-icon\">🥤</div><h4>40 Calories</h4><p>9g sugar, sweetened with organic agave &mdash; no artificial sweeteners.</p></div>\n    <div class=\"happie-coll-seo__feature\"><div class=\"happie-coll-seo__feature-icon\">🍃</div><h4>Caffeine-Free</h4><p>No caffeine, no alcohol. Tastes like a seltzer, not a shake.</p></div>\n  </div>\n  <div class=\"happie-coll-seo__why\">\n    <h3>A Sparkling Mushroom Drink, Done Right</h3>\n    <p>Unlike mushroom coffee or mushroom tea, Fungi Fusion is a crisp, fruit-flavoured sparkling drink made with real mushrooms &mdash; Lion&rsquo;s Mane, Cordyceps and Red Reishi &mdash; plus magnesium and calcium from ocean minerals. Caffeine-free and alcohol-free.</p>\n    <p>Bold, juicy flavour with fine bubbles and a clean finish. 40 calories, 9g sugar, no artificial sweeteners. It tastes like a seltzer, not a shake.</p>\n    <div class=\"happie-coll-seo__badges\">\n      <span class=\"happie-coll-seo__badge\">Caffeine-Free</span>\n      <span class=\"happie-coll-seo__badge\">Alcohol-Free</span>\n      <span class=\"happie-coll-seo__badge\">No Artificial Sweeteners</span>\n      <span class=\"happie-coll-seo__badge\">Vegan &amp; Gluten-Free</span>\n      <span class=\"happie-coll-seo__badge\">Ships Nationwide</span>\n    </div>\n  </div>\n  {% elsif collection.handle == 'social' %}\n  <div class=\"happie-coll-seo__intro\">\n    <span class=\"happie-coll-seo__eyebrow\">The Premium Alcohol Alternative</span>\n    <h2>{{ collection.title }}</h2>\n    <p class=\"happie-coll-seo__lead\">Happie Social Seltzers are the perfect THC drinks for parties, social gatherings, and everyday relaxation &mdash; available in 5mg (mild buzz) and 10mg (stronger effect), with zero hangover and only 30 calories per can.</p>\n  </div>\n  <div class=\"happie-coll-seo__why\">\n    <h3>Your Best Social Tonic</h3>\n    <p>Join the sober curious movement with the best social tonic on the market. A clean, functional buzz for mindful drinkers who want a premium alcohol alternative &mdash; try our variety pack to find your favorite flavor.</p>\n    <div class=\"happie-coll-seo__badges\">\n      <span class=\"happie-coll-seo__badge\">Zero Hangover</span>\n      <span class=\"happie-coll-seo__badge\">5mg &amp; 10mg</span>\n      <span class=\"happie-coll-seo__badge\">Only 30 Calories</span>\n      <span class=\"happie-coll-seo__badge\">Alcohol-Free</span>\n    </div>\n  </div>\n  {% elsif collection.description != blank %}\n  <div class=\"happie-coll-seo__intro\">\n    <h2>{{ collection.title }}</h2>\n    <p class=\"happie-coll-seo__lead\">{{ collection.description }}</p>\n  </div>\n  {% endif %}\n</div>",
