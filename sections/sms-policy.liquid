{%- comment -%}
  SMS policy page body: page title + page content exactly as written in Shopify admin.
  No product, collection or FAQ content. Used by templates/page.sms.json with layout/sms.liquid.
{%- endcomment -%}
<article class="sms-policy">
  <span class="sms-policy__eyebrow">Text messaging policy</span>
  <h1 class="sms-policy__title">{{ page.title }}</h1>
  <div class="sms-policy__body">
    {{ page.content }}
  </div>
</article>

<style>
  .sms-policy { max-width: 760px; margin: 0 auto; padding: 56px 24px 72px; }
  .sms-policy__eyebrow { display: inline-block; font-size: 11.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--plum, #962F80); background: #F6E6F1; padding: 6px 12px; border-radius: 999px; margin-bottom: 16px; }
  .sms-policy__title { font-size: clamp(28px, 4.4vw, 40px); line-height: 1.15; font-weight: 800; letter-spacing: -.02em; color: var(--ink, #1A1426); margin: 0 0 28px; }
  .sms-policy__body { background: #fff; border: 1px solid var(--line, #ECE4F0); border-radius: 18px; padding: 32px 36px; box-shadow: 0 10px 30px rgba(150, 47, 128, .06); font-size: 16.5px; line-height: 1.8; color: var(--body, #3F3550); }
  .sms-policy__body > :first-child { margin-top: 0; }
  .sms-policy__body > :last-child { margin-bottom: 0; }
  .sms-policy__body p { margin: 0 0 1.1em; }
  .sms-policy__body h2, .sms-policy__body h3 { color: var(--ink, #1A1426); font-weight: 700; line-height: 1.3; margin: 1.6em 0 .5em; }
  .sms-policy__body ul, .sms-policy__body ol { padding-left: 1.3em; margin: 0 0 1.1em; }
  .sms-policy__body a { color: var(--plum, #962F80); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; word-break: break-word; }
  .sms-policy__body strong { color: var(--ink, #1A1426); }
  @media (max-width: 600px) {
    .sms-policy { padding: 36px 16px 52px; }
    .sms-policy__body { padding: 22px 20px; font-size: 15.5px; line-height: 1.75; border-radius: 14px; }
  }
</style>

{% schema %}
{
  "name": "SMS policy page",
  "tag": "section",
  "settings": []
}
{% endschema %}
